{
  "expo": {
    "name": "FarmingCompanion",
    "slug": "FarmingCompanion",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.carottejy.farmingcompanion",
      "buildNumber": "4",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "La position du jardin sert à adapter le calendrier de semis à votre climat.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E8F5E9",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.carottejy.farmingcompanion",
      "versionCode": 4,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "FarmingCompanion",
      "shortName": "Farming",
      "lang": "fr",
      "themeColor": "#2E7D32",
      "backgroundColor": "#F7F5EF"
    },
    "scheme": "farmingcompanion",
    "description": "Conseils de plantation pour les planches de jardin partagé : rotation, calendrier et climat.",
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "La position du jardin sert à adapter le calendrier de semis à votre climat."
        }
      ]
    ]
  }
}
