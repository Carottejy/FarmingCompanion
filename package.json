{
  "name": "farmingcompanion",
  "version": "1.3.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~58.0.24",
    "expo-application": "~58.1.2",
    "expo-constants": "~58.0.16",
    "expo-linking": "~58.0.17",
    "expo-location": "~58.0.21",
    "expo-router": "~58.0.31",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build:web": "WEB_BASE_URL=${WEB_BASE_URL-/FarmingCompanion} expo export --platform web --output-dir dist && WEB_BASE_URL=${WEB_BASE_URL-/FarmingCompanion} node scripts/make-pwa.mjs dist"
